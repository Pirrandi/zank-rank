# Base de datos SQLite local
DATABASE_URL="file:./dev.db"


# Bot de Discord (interacciones, comandos y mensajes del ranking)
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_PREDICTIONS_CHANNEL_ID=
DISCORD_PUBLIC_KEY=

# Login con Discord (OAuth). Si falta DISCORD_CLIENT_ID, el botón de Discord no se muestra
# en /admin/login y el flujo OAuth queda desactivado.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=

# API de Riot Games
RIOT_API_KEY=

# Firma de sesiones del admin
SESSION_SECRET=
# Hash generado con `npm run hash-admin-password` (sal:hash)
ADMIN_PASSWORD_HASH=
